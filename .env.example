# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your credentials.
# ==============================================================================

# 1. Local Testing: Google Gemini API Key
GEMINI_API_KEY=

# 2. GCP Production: Vertex AI Configuration
USE_VERTEX_AI=false
GCP_PROJECT_ID=
GCP_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=

# 3. Model Configuration
GEMINI_MODEL_NAME=gemini-2.5-flash

# 4. Application Settings
DEBUG=true
LOG_LEVEL=DEBUG
UPLOAD_DIR=uploads
TEMP_DIR=tmp

# 5. Groq LPU API Configuration (Low-Token & Sub-Second Structuring)
GROQ_API_KEY=
GROQ_MODEL_NAME=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
