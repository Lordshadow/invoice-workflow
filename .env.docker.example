# ==============================================================================
# LedgerFlow Enterprise - Docker & Production Environment Configuration
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env
# ==============================================================================

# --- AI Extraction & Cloud Providers ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b
GEMINI_MODEL_NAME=gemini-3.7-flash

# --- Straight-Through Processing (STP) ---
STP_DEFAULT_ENABLED=true
STP_MIN_CONFIDENCE_THRESHOLD=0.85
STP_MAX_AMOUNT_LIMIT=100000.0

# --- Automated Email Ingestion (IMAP) ---
ENABLE_EMAIL_POLLER=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_google_app_password
IMAP_FOLDER=INBOX

# --- Two-Factor Authentication & Outbound Email (SMTP) ---
ENABLE_2FA=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_USE_TLS=true
SMTP_FROM_NAME="LedgerFlow Security"

# --- Database Configurations (PostgreSQL Containers) ---
POSTGRES_DB=pipeline_db
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_secure_pass_2026
POSTGRES_PORT=5432

TARGET_POSTGRES_DB=company_erp_db
TARGET_POSTGRES_USER=target_admin
TARGET_POSTGRES_PASSWORD=target_secure_pass_2026
TARGET_POSTGRES_PORT=5433

# --- Redis Broker ---
REDIS_PORT=6379
